@page
@model WordGuessingGame.Pages.IndexModel
@{
    ViewData["Title"] = "Word guessing game";
}

<div class="index">
    <form method="post" id="guessForm">
        <div class="field" id="field">
            <input type="text" name="letter" class="field__input" required maxlength="1" />
            <input type="text" name="letter" class="field__input" required maxlength="1" />
            <input type="text" name="letter" class="field__input" required maxlength="1" />
            <input type="text" name="letter" class="field__input" required maxlength="1" />
            <input type="text" name="letter" class="field__input" required maxlength="1" />
            <input type="text" name="letter" class="field__input" required maxlength="1" />
        </div>
    </form>
</div>


<script>
    (function() {
      var inputs = document.querySelectorAll("#field input");
      inputs.forEach(function(input, i) {
        input.addEventListener("keyup", function(e) {
          if (input.value.length === input.maxLength && inputs[i + 1]) {
            inputs[i + 1].focus();
          } else if (e.key === "Backspace" && !input.value.length && inputs[i - 1]) {
            inputs[i - 1].focus();
          }
          var allFilled = Array.from(inputs).every(function(inp) {
            return inp.value.length === inp.maxLength;
          });
          if (allFilled) {
            document.getElementById("guessForm").submit();
          }
        });
      });
    })();
</script>